{
  "name": "telnyx-wdio-tests",
  "version": "1.0.0",
  "description": "WebdriverIO E2E tests for Telnyx website",
  "type": "module",
  "scripts": {
    "test": "wdio run wdio.conf.js",
    "test:chrome": "wdio run configs/wdio.chrome.conf.js",
    "test:firefox": "wdio run configs/wdio.firefox.conf.js",
    "test:edge": "wdio run configs/wdio.edge.conf.js",
    "test:file": "wdio run wdio.conf.js --spec",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open"
  },
  "dependencies": {},
  "devDependencies": {
    "@wdio/allure-reporter": "^9.0.0",
    "@wdio/cli": "^9.0.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "allure-commandline": "^2.30.0",
    "chromedriver": "latest",
    "dotenv": "^16.4.5",
    "geckodriver": "latest",
    "wdio-chromedriver-service": "^8.0.0",
    "wdio-geckodriver-service": "^5.0.0"
  }
}
